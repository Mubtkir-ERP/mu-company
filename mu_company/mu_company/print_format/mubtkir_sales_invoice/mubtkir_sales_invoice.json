 "html": "<table class=\"main-table\" style=\"width:100%;\">\n    <thead style=\"width:100%;\">\n        <tr>\n            <td style=\"padding:0 !important;\">\n            <header class=\"header\" style=\"display: flex; justify-content: space-between; align-items: center;\">\n            <div>\n                <!-- {% if doc.docstatus ==\"1\" and doc.ksa_einv_qr  %}-->\n                <!--            <img class=\"logo\"width=\"100px !important\" height=\"100px !important\" src={{doc.ksa_einv_qr}} alt=\"QR Code\">-->\n                <!--{% endif %}-->\n                {% if doc.status!=\"Draft\" %}\n                            <img class=\"logo_2\" style=\"height:110px !important; width:110px !important;\" src=\"data:image/png;base64, {{ get_zatca_phase_1_qr_for_invoice(doc.name) }}\">\n                {% endif %}\n            </div>\n              <div class=\"invoice-title\">\n              <h1 class=\"m-0\" style=\"font-size:28px;\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629</h1>\n              <h2 class=\"m-0\" style=\"font-weight:600;font-size:25px;\">TAX INVOICE</h2>\n            </div>\n              <img class=\"logo\" style=\"height:130px !important; width:130px !important;\" src=\"/files/mubtkir_logo.png\" alt=\"Company Logo\" height=\"100px !important\">\n            </header>\n            </td>\n        <!-- Header Section -->\n        \n        </tr>\n    </thead>\n    <tbody style=\"width:100%;\">\n        <tr>\n            <td>\n                    <div style=\"display:flex;gap:10px;padding:10px 20px;\">\n                 <table class=\"container-t1\">\n                      <tr>\n                        <th class=\"left main-color\">Bill Tocenter</th>\n                        <th style=\"font-weight:100 !important;\" class=\"center\"></th>\n                        <th class=\"right main-color\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0625\u0644\u0649</th>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">Name</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{doc.get(\"customer\")}}</td>\n                        <td class=\"right\">\u0627\u0644\u0627\u0633\u0645</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">Address</td>\n                        \n                        <td style=\"font-weight:100 !important;\" class=\"center\">\n                        {% if doc.customer_address%}\n                        {% set customer_add = frappe.get_doc(\"Address\", doc.customer_address)%}\n                            {{customer_add.city or \"\"}},{{customer_add.custom_area or \"\"}}{{customer_add.address_line1 or \"\"}}\n                        {% endif %}\n                        </td>\n                        <td class=\"right\">\u0627\u0644\u0639\u0646\u0648\u0627\u0646</td>\n                      </tr>\n                      <tr>\n                          {% set vat_no = frappe.get_doc(\"Customer\", doc.customer_name)%}\n                        <td class=\"left\">Vat .No.</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{vat_no.custom_vat_registration_number or \"\"}}</td>\n                        <td class=\"right\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">CR No.</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{ vat_no.custom_commercial_register_no or \"\" }}</td>\n                        <td class=\"right\">\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">Mobile</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">\n                        {% if doc.customer_address%}\n                        {% set customer_add = frappe.get_doc(\"Address\", doc.customer_address)%}\n                        {{ customer_add.phone or \"\" }}\n                        {% endif %}\n                           </td>\n                        </td>\n                        <td class=\"right\">\u0627\u0644\u062c\u0648\u0627\u0644</td>\n                      </tr>\n                    </table>\n                <table class=\"container-t1\">\n                      <tr>\n                        <th class=\"left main-color\">Bill From</th>\n                        <th style=\"font-weight:100 !important;\" class=\"center\"></th>\n                        <th class=\"right main-color\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0645\u0646</th>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">Name</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{doc.get(\"company\") or \"\"}}</td>\n                        <td class=\"right\">\u0627\u0644\u0627\u0633\u0645</td>\n                      </tr>\n                      <tr>\n                           <td class=\"left\">Address</td>\n                          {% if doc.company_address%}\n                          {% set company_address = frappe.get_doc(\"Address\", doc.company_address)%}\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{company_address.city or \"\"}},{{company_address.custom_area or \"\"}}{{company_address.address_line1 or \"\"}}</td>\n                        {%else%}\n                        <td style=\"font-weight:100 !important;\" class=\"center\"></td>\n                        {% endif %}\n                        <td class=\"right\">\u0627\u0644\u0639\u0646\u0648\u0627\u0646</td>\n                      </tr>\n                      <tr>\n                          {% set company = frappe.get_doc(\"Company\", doc.company)%}\n                        <td class=\"left\">Vat .No.</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{company.tax_id or \"\"}}</td>\n                        <td class=\"right\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">CR No.</td>\n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{ company.custom_commercial_register_no or \"\" }}</td>\n                        <td class=\"right\">\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\">Mobile</td>\n                        {%if doc.company_address %} \n                        <td style=\"font-weight:100 !important;\" class=\"center\">{{company_address.phone or \"\"}}</td>\n                        {%else%}\n                        <td style=\"font-weight:100 !important;\" class=\"center\"></td>\n                        {% endif %}\n                        <td class=\"right\">\u0627\u0644\u062c\u0648\u0627\u0644</td>\n                      </tr>\n                    </table>\n                    </div>\n                        <div style=\"padding:2px 20px;\">\n                            <table class=\"t4\">\n                              <tr>\n                                <th style=\"color:black;font-size: 12px;\">Notes:</th>\n                                <th  style=\" color:black;font-weight:100 !important;text-align: center;width:33.7% !important;\">{{doc.custom_note or \"\"}}</th>\n                                <th style=\"color:black;width:9.7% !important;font-size: 12px;\">\u0645\u0644\u0627\u062d\u0638\u0627\u062a</th>\n                                <th style=\"color:black; text-align: start;font-size: 12px;\">Invoice Number</th>\n                                <th style=\"color:black; font-weight:100 !important;font-size: 12px;\">{{doc.get(\"name\") or \"\"}}</th>\n                                <th style=\"color:black; text-align: end;font-size: 12px;\">\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</th>\n                              </tr>\n                              <tr>\n                                <td></td>\n                                <td class=\"center\" style=\"font-weight:100 !important;font-size: 12px;\">{{doc.get(\"remarks\") or \"\"}}</td>\n                                <td></td>\n                                <td style=\"text-align: start;font-size: 12px;\">Invoice Data</td>\n                                <td style=\"text-align: center; font-weight:100 !important; font-size: 12px;\">{{doc.get(\"posting_date\") or \"\"}}</td>\n                                <td style=\"text-align: end; font-size: 12px;\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</td>\n                              </tr>\n                              <tr>\n                                <td></td>\n                                <td></td>\n                                <td></td>\n                                <td style=\"font-size: 12px;\">Created By</td>\n                                <td style=\"font-weight:100 !important; text-align:center;font-size: 12px;\">{{doc.get(\"modified_by\")}}</td>\n                                <td style=\"text-align: end;font-size: 12px;\">\u062a\u0645 \u0627\u0644\u0625\u0646\u0634\u0627\u0621 \u0628\u0648\u0627\u0633\u0637\u0629</td>\n                              </tr>\n                            </table>\n                        </div>\n                        \n                <div style=\"padding:5px 20px;\">\n                    <table class=\"container-t2\">\n                          <tr class=\"back\" style=\"border:none !important;\">\n                            <th class=\"center\" style=\"border-radius:10px 0px 0px 0px;padding:4px 0px 0px !important;background-color:#644ca6;\">\u0627\u0644\u0645\u062c\u0645\u0648\u0639</th>\n                            <!--<th class=\"center \" style=\"padding:4px 0px !important;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629</th>-->\n                            <th class=\"center \" style=\"padding:4px 0px 0px !important;background-color:#644ca6;\">\u0627\u0644\u0643\u0645\u064a\u0629</th>\n                            <th class=\"center \" style=\"padding:4px 0px 0px !important;background-color:#644ca6;\">\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</th>\n                            <th class=\"right \" style=\"padding:4px 0px 0px !important;background-color:#644ca6;\">\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a</th>\n                            <th style=\"border-radius:0px 10px 0px 0px;background-color:#644ca6;\"></th>\n                          </tr>\n                          <tr class=\"back\"  style=\"border:none !important;\">\n                            <th class=\"center\" style=\"border-radius:0px 0px 0px 10px; padding:0px 0px !important;background-color:#644ca6;\">TOTAL</th>\n                            <!--<th class=\"center\" style=\"padding:2px 0px !important;\">TAXABLE AMOUNT</th>-->\n                            <th class=\"center\" style=\"padding:0px 0px !important;background-color:#644ca6;\">QUANTITY</th>\n                            <th class=\"center\" style=\"padding:0px 0px !important;background-color:#644ca6;\">UNIT PRICE</th>\n                            <th class=\"right\" style=\"padding:0px 0px !important;background-color:#644ca6;\">NATURE OF ITEMS OR SERVICES</th>\n                            <th style=\"border-radius:0px 0px 10px 0px;background-color:#644ca6;\"></th>\n                          </tr>\n                         {% for row in doc.items%}\n                          <tr class=\"other\">\n                            <td class=\"center\">{{row.amount}}</td>\n                            <!--<td class=\"center\">{{row.amount}}</td>-->\n                            <td class=\"center\">{{row.qty}}</td>\n                            <td class=\"center\">{{row.rate}}</td>\n                            <td class=\"right\" style=\"font-weight: lighter !important; direction: rtl; text-align: right;\"><b>{{row.item_name}}</b><br>{{row.description}}</td>\n                            <td class=\"right\">{{row.idx}}</td>\n                          </tr>\n                          {% endfor %}\n                          \n                    </table>\n\n                </div>\n                <div style=\"padding:8px 20px;\">\n                    <table class=\"t3\">\n                      <tr>\n                        <td class=\"left\" style=\"font-size:12px; font-weight:100 !important;\">Subtotal Excl. VAT</td>\n                        <td class=\"bold center\">{{doc.get(\"total\") or \"\"}}</td>\n                        <td class=\"right\" style=\"font-weight:100 !important;\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0642\u064a\u0645\u0629 \u0628\u062f\u0648\u0646 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\" style=\"font-size:12px; font-weight:100 !important;\">Discount</td>\n                        <td class=\"bold center\">{{doc.get(\"discount_amount\")or  \"\"}}</td>\n                        <td class=\"right\" style=\"font-weight:100 !important;\">\u0627\u0644\u062e\u0635\u0645</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\" style=\"font-size:12px; font-weight:100 !important;\">Taxable Amount</td>\n                        <td class=\"bold center\">{{doc.get(\"total\") or \"\"}}</td>\n                        <td class=\"right\" style=\"font-weight:100 !important;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u0628\u064a\u0629</td>\n                      </tr>\n                      <tr>\n                        <td class=\"left\" style=\"font-size:12px; font-weight:100 !important;\">Total VAT</td>\n                        <td class=\"bold center\">{{doc.get(\"total_taxes_and_charges\") or \"\"}}</td>\n                        <td class=\"right\" style=\"font-weight:100 !important;\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                      </tr>\n                      <tr style=\"background-color:#e1e1e1;height:1px;padding:0;\">\n                      <td style=\"padding:0 !important;\"></td>\n                      <td style=\"padding:0 !important;\"></td>\n                      <td style=\"padding:0 !important;\"></td>\n                      </tr>\n                      <tr style=\"color:#6a54aa !important;;\">\n                        <td style=\"color:#6a54aa !important;\" class=\"left\">Total Including VAT</td>\n                        <td  style=\"color:#6a54aa !important;\" class=\"bold center\">{{doc.get(\"grand_total\")}}</td>\n                        <td style=\"color:#6a54aa !important;\" class=\"right\">\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0645\u0639 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                      </tr>\n                    </table>\n                </div>\n            </td>\n        </tr>\n   <div class=\"bg-img\">\n    <img src=\"/files/2.png\" alt=\"\" width=\"600px\" class=\"img\">\n    </div>\n    </tbody>\n\n<tfoot style=\"width:100%;\">\n    <div>\n        <img class=\"footer-lora\" src=\"/files/footer.png\">            \n        </div>\n    \n</tfoot>\n</table>\n{%if doc.tc_name %}\n<tr>\n  <td>\n        <div class=\"he\">\n            <h1 class=\"t\">{{doc.tc_name or \"\"}}</h1>\n        </div>\n    <div class=\"term\" style=\"direction: rtl; text-align: right; padding-right: 20px;\">\n      {{ doc.terms | safe }}\n    </div>\n  </td>\n</tr>\n{%endif %}",
