eft;\n    padding: 8px;\n}\n.bold{\n    font-weight:600;\n}\n.t4\n{\n    border-radius:10px;\n    background-color:#ebebeb;\n    font-family: arial, sans-serif;\n    border-collapse: collapse;\n    width: 100%;\n}\n.t4 td, th {\n  text-align: left;\n  padding: 10px 20px;\n}\n.print-format .img{\n    z-index:-1;\n}\n.bg-img{\n    position: fixed;\n    bottom: -77px;\n    left: -86px;\n}\ni.icon{\n    color:white !important;\n}\nhtml {\n    direction: ltr;\n }\n .back{\n    background-color: #644ca6;\n }\n.t{\n    text-align:center;\n    padding-top:13px;\n    height:60px;\n    width:35%;\n    background: linear-gradient(90deg, #3c5ca4, #00C6FF);\n    margin-left:240px;\n    margin-top:300px;\n    border-radius:13px;\n    color:white;\n    font-weight:600;\n}\nul,li,ol{\n    font-size:14px;\n    font-weight: 550;\n}\n.h3{\n    font-size:25px;\n    font-weight: 600;\n    color: #337ab7\n}\n.footer-lora {\n      position: fixed !important;\n      bottom: 0 !important;\n      text-align: center;\n    }\n@media print {\n    .logo_2{\n        width:100px !important;\n    }\n    thead{\n        display:table-row-group;\n    }\n    html {\n        direction: ltr;\n    }\n    .container-t2 {\n      font-family: arial, sans-serif;\n      border-collapse: collapse;\n      width: 100%;\n      border-radius:10px;\n    }\n    .container-t2 .other{\n    \tbackground-color:#ebebeb;\n    }\n    .container-t2 td,th {\n      padding: 8px;\n    }\n    .container-t2 td{\n    \tfont-weight:600;\n    }\n    .footer-lora {\n      position: fixed !important;\n      bottom: 0 !important;\n      text-align: center;\n    }\n    .ql-editor li.ql-direction-rtl > .ql-ui:before {\n        margin-right: -0.7em !important;\n        margin-left: -1.5em !important;\n        text-align: right !important;\n    }\n}\n.ql-editor li.ql-direction-rtl > .ql-ui:before {\n        margin-right: -0.7em !important;\n        margin-left: -1.5em !important;\n        text-align: right !important;\n}\n",
